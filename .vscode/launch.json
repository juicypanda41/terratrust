{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TerraTrust",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api:app", "--host", "127.0.0.1", "--port", "8501"],
      "console": "integratedTerminal"
    },
    {
      "name": "Train TerraTrust",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "console": "integratedTerminal"
    }
  ]
}
