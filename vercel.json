{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && pnpm install --frozen-lockfile && pnpm build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api.py": {
      "includeFiles": "{artifacts/**,assets/demo_samples/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api.py"
    },
    {
      "source": "/demo-assets/:path*",
      "destination": "/api.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
